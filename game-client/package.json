{
  "name": "barrowspire-client",
  "version": "1.0.0",
  "description": "The Age of Barrowspire — web client (Next.js + Phaser 3)",
  "scripts": {
    "dev": "next dev -p 3938",
    "dev:kind:a": "NEXT_DIST_DIR=.next-kind-a NEXT_PUBLIC_API_URL=http://localhost:7214 NEXT_PUBLIC_GAME_SERVER_ADDR=ws://localhost:5660/game/ws next dev -p 3940",
    "dev:kind:b": "NEXT_DIST_DIR=.next-kind-b NEXT_PUBLIC_API_URL=http://localhost:7214 NEXT_PUBLIC_GAME_SERVER_ADDR=ws://localhost:5661/game/ws next dev -p 3941",
    "dev:gke:a": "NEXT_DIST_DIR=.next-gke-a NEXT_PUBLIC_API_URL=https://api.barrowspire.app NEXT_PUBLIC_GAME_SERVER_ADDR=wss://play.barrowspire.app/game/ws next dev -p 3942",
    "dev:gke:b": "NEXT_DIST_DIR=.next-gke-b NEXT_PUBLIC_API_URL=https://api.barrowspire.app NEXT_PUBLIC_GAME_SERVER_ADDR=wss://play.barrowspire.app/game/ws next dev -p 3943",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:fence": "./lint-fence.sh",
    "bake": "node tools/bake/bake.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@types/socket.io-client": "^3.0.0",
    "next": "^15.5.28",
    "openapi-fetch": "^0.17.0",
    "phaser": "^3.80.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eventemitter3": "^5.0.4",
    "playwright-core": "1.61.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "three": "0.160.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
